
class Solution {
    public int isPrime(int  N) {
        if(N == 1 ) return 0;
        
        boolean isPrime = true;

        for(int i = 2;i<=N-1;i++){
            if (N % i == 0){
                isPrime = false;
                break;
            }
        }

        if(isPrime) return 1;
        else return 0;
        
    }
}